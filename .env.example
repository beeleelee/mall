# Server
PORT=8080

# Database
DATABASE_URL=postgres://mall:mall_dev@localhost:5432/mall?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production

# NATS (JetStream)
NATS_URL=nats://localhost:4222

# Saga / DTM
DTM_SERVER=http://localhost:36789/api/dtmsvr
SAGA_CALLBACK_URL=http://localhost:8080
SAGA_SECRET=

# MinIO (object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mall

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mall.example.com

# OpenTelemetry
OTEL_ENDPOINT=
OTEL_BATCHER=otlpgrpc

# Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Application
BASE_URL=http://localhost:8080

# Logging
DEV=false
JSON_LOG=false
LOG_LEVEL=info
